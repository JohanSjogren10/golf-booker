// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  phone         String?
  notifyEmail   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  watches  Watch[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// A watch represents a user wanting to be notified when a specific tee time opens
model Watch {
  id         String   @id @default(cuid())
  userId     String
  courseId   String   // Sweetspot course ID
  courseName String   // Human-readable course name
  date       String   // ISO date string YYYY-MM-DD
  timeFrom   String   // Start of desired time window HH:MM
  timeTo     String   // End of desired time window HH:MM
  players    Int      @default(1) // Minimum number of available spots
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

// Log of sent notifications to avoid duplicate alerts
model Notification {
  id        String   @id @default(cuid())
  watchId   String
  teeTimeId String   // Sweetspot tee time slot ID
  sentAt    DateTime @default(now())
  channel   String   // "email" | "sms"

  watch Watch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([watchId, teeTimeId, channel])
}
